{
  "name": "ruqyah-center-feni",
  "version": "1.0.0",
  "description": "Ruqyah Support & Cupping Center (Feni Branch) - Web Application, Online Appointment Booking & Patient CRM",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "seed": "node database/seed.js",
    "test": "node test/system.test.js",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path').join('node_modules','better-sqlite3','prebuilds');if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true});\" && npm rebuild better-sqlite3 --build-from-source"
  },
  "keywords": [
    "ruqyah",
    "hijama",
    "cupping",
    "clinic",
    "appointment-booking",
    "patient-crm",
    "feni",
    "bangladesh"
  ],
  "author": "Ruqyah Support & Cupping Center",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  }
}
